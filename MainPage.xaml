<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClickerApp.MainPage">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B1B2E" Offset="0.0" />
            <GradientStop Color="#2D1B4E" Offset="0.55" />
            <GradientStop Color="#1F1440" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ContentPage.Resources>
        <Style x:Key="ShopButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="HeightRequest" Value="56" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16,0" />
        </Style>

        <Style x:Key="StatChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="Stroke" Value="#33FFFFFF" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalOptions" Value="Fill" />
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="24,32"
            Spacing="18"
            VerticalOptions="Center">

            <Label
                Text="КЛІКЕР"
                FontSize="34"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center">
                <Label.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.4" />
                </Label.Shadow>
            </Label>

            <Border
                x:Name="AchievementBadge"
                Background="#2E7D32"
                Stroke="#66FFA6"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="16,8"
                HorizontalOptions="Center"
                IsVisible="False"
                Opacity="0">
                <Label
                    x:Name="AchievementLabel"
                    Text=""
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalOptions="Center" />
            </Border>

            <Border
                Background="#1AFFFFFF"
                Stroke="#26FFFFFF"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 28"
                Padding="20,28">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,8" Radius="24" Opacity="0.35" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18" HorizontalOptions="Center">

                    <Label
                        x:Name="CoinsLabel"
                        Text="Монети: 0"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="#FFD700"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="ClickButton"
                        Text="КЛІК!"
                        FontSize="28"
                        FontAttributes="Bold"
                        HeightRequest="160"
                        WidthRequest="160"
                        CornerRadius="80"
                        BackgroundColor="#43A047"
                        TextColor="White"
                        HorizontalOptions="Center"
                        Clicked="OnClickButtonClicked">
                        <Button.Shadow>
                            <Shadow Brush="#4CAF50" Offset="0,8" Radius="24" Opacity="0.55" />
                        </Button.Shadow>
                    </Button>

                    <Label
                        x:Name="FloatingLabel"
                        Text=""
                        FontSize="19"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HeightRequest="26"
                        Opacity="0" />

                    <Grid ColumnSpacing="10" RowSpacing="10" HorizontalOptions="Fill">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatChipStyle}">
                            <Label x:Name="ClickPowerLabel" Text="За клік: 1" TextColor="White" Style="{StaticResource StatLabelStyle}" />
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatChipStyle}">
                            <Label x:Name="AutoClickerLabel" Text="Автоклікери: 0" TextColor="White" Style="{StaticResource StatLabelStyle}" />
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StatChipStyle}">
                            <Label x:Name="CritChanceLabel" Text="Шанс криту: 5% (x5)" TextColor="#FF8A80" Style="{StaticResource StatLabelStyle}" />
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatChipStyle}">
                            <Label x:Name="PrestigeLabel" Text="Престиж: 0 ★" TextColor="#CE93D8" Style="{StaticResource StatLabelStyle}" />
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Border
                Background="#1AFFFFFF"
                Stroke="#26FFFFFF"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 28"
                Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,8" Radius="24" Opacity="0.35" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="МАГАЗИН"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"
                        Margin="0,0,0,6" />

                    <Button
                        x:Name="UpgradeButton"
                        Text="Покращити клік — 10 монет"
                        Style="{StaticResource ShopButtonStyle}"
                        BackgroundColor="#2E7D32"
                        Clicked="OnUpgradeClicked" />

                    <Button
                        x:Name="AutoClickerButton"
                        Text="Купити автоклікер — 50 монет"
                        Style="{StaticResource ShopButtonStyle}"
                        BackgroundColor="#1565C0"
                        Clicked="OnBuyAutoClickerClicked" />

                    <Button
                        x:Name="CritChanceButton"
                        Text="Прокачати крит — 100 монет"
                        Style="{StaticResource ShopButtonStyle}"
                        BackgroundColor="#C2185B"
                        Clicked="OnBuyCritChanceClicked" />

                    <Button
                        x:Name="PrestigeButton"
                        Text="Престиж (мін. 1 000 монет)"
                        Style="{StaticResource ShopButtonStyle}"
                        BackgroundColor="#6A1B9A"
                        Clicked="OnPrestigeClicked" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
